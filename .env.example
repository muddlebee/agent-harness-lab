# Live-model configuration. Keep API keys in your shell profile, never in this file.
# OpenRouter's OpenAI-compatible API routes the DeepSeek model below.
FINANCIAL_AGENT_PROVIDER=openrouter
FINANCIAL_AGENT_MODEL=deepseek/deepseek-chat
FINANCIAL_AGENT_BASE_URL=https://openrouter.ai/api/v1

# Optional Langfuse observability. This file is ignored by Git, so keys may stay local here.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keep local/evaluation traces separate from production traffic.
LANGFUSE_TRACING_ENVIRONMENT=development
# Set true only for synthetic or otherwise approved trace content.
LANGFUSE_CAPTURE_CONTENT=false
# Normally generated fresh by scripts/run-live-eval.sh. Set only to deliberately reuse a session.
# FINANCIAL_AGENT_EVAL_RUN_ID=

# Required for non-OpenAI providers. Set this in your shell profile, not this file.
# FINANCIAL_AGENT_API_KEY=

# Provider-specific variables (for example OPENROUTER_API_KEY and OPENROUTER_MODEL) remain
# supported for backward compatibility, but FINANCIAL_AGENT_API_KEY, FINANCIAL_AGENT_MODEL, and
# FINANCIAL_AGENT_BASE_URL are preferred for OpenAI-compatible providers.
